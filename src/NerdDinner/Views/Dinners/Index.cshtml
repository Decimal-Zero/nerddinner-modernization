@model IPagedList<Dinner>
@{
    ViewBag.Title = "Upcoming Nerd Dinners";
}
<div class='hslice' id='1'>
    <h2 class='entry-title'>
        Upcoming Dinners</h2>
    <a rel='feedurl' href='/Dinners/WebSliceUpcoming' style='display: none;'></a>
    <ul class="upcomingdinners">
        @foreach (var dinner in Model)
        {
            <li>
                <a asp-action="Details" asp-route-id="@dinner.DinnerID">@dinner.Title</a>
                on <strong>@dinner.EventDate.ToString("yyyy-MMM-dd")
                    @dinner.EventDate.ToString("HH:mm tt")</strong> at
                @(dinner.Address + " " + dinner.Country)
            </li>
        }
    </ul>
</div>
@await Html.PartialAsync("DinnerPagination", Model)
