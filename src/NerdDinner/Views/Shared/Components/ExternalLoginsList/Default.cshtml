@model IEnumerable<Microsoft.AspNetCore.Authentication.AuthenticationScheme>

@{
    var schemes = Model.Where(s => !string.IsNullOrEmpty(s.DisplayName)).ToList();
}

@if (schemes.Count == 0)
{
    <div class="message-info">
        <p>There are no external authentication services configured. See <a href="http://go.microsoft.com/fwlink/?LinkId=252166">this article</a>
        for details on setting up this ASP.NET application to support logging in via external services.</p>
    </div>
}
else
{
    using (Html.BeginForm("ExternalLogin", "Account", new { ReturnUrl = ViewBag.ReturnUrl }))
    {
    @Html.AntiForgeryToken()
    <fieldset id="socialLoginList">
        <legend>Log in using another service</legend>
        <p>
        @foreach (var scheme in schemes)
        {
            <button type="submit" name="provider" value="@scheme.Name" title="Log in using your @scheme.DisplayName account">@scheme.DisplayName</button>
        }
        </p>
    </fieldset>
    }
}
