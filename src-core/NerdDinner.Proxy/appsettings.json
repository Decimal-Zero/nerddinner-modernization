{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ipInfoDbKey": "",
  "BingMapsKey": "",
  "ReverseProxy": {
    "Routes": {
      "legacy-catchall": {
        "ClusterId": "legacyCluster",
        "Order": 1000,
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "legacyCluster": {
        "Destinations": {
          "legacyApp": {
            "Address": "http://localhost:10581/"
          }
        }
      }
    }
  }
}
