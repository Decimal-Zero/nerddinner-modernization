{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ipInfoDbKey": "",
  "BingMapsKey": "",
  "GeoNames": {
    "UserName": ""
  },
  "googleClientId": "",
  "googleClientSecret": "",
  "microsoftClientId": "",
  "microsoftClientSecret": "",
  "facebookAppId": "",
  "facebookAppSecret": "",
  "twitterConsumerKey": "",
  "twitterConsumerSecret": "",
  "ConnectionStrings": {
    "NerdDinnerContext": "Data Source=(LocalDB)\\MSSQLLocalDB;Initial Catalog=NerdDinner;Integrated Security=True;MultipleActiveResultSets=True",
    "DefaultConnection": "Data Source=(LocalDB)\\MSSQLLocalDB;Initial Catalog=NerdDinner.Identity;Integrated Security=True;MultipleActiveResultSets=True"
  },
  "ReverseProxy": {
    "Routes": {
      "legacy-catchall": {
        "ClusterId": "legacyCluster",
        "Order": 1000,
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "legacyCluster": {
        "Destinations": {
          "legacyApp": {
            "Address": "http://localhost:10581/"
          }
        }
      }
    }
  }
}
